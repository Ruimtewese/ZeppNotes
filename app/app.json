{
  "configVersion": "v3",

  "app": {
    "appId": 25708,
    "appName": "Quick Notes",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "zepp",
    "description": "A simple notes app for Zepp OS"
  },

  "permissions": [
    "data:os.device.info",
    "device:os.local_storage"
  ],

  "runtime": {
    "apiVersion": {
      "compatible": "4.2",
      "target": "4.2",
      "minVersion": "4.2"
    }
  },

  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": [
            "page/index",
            "page/note",
            "page/view-note"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        }
      },

      "platforms": [
        {
          "st": "r",
          "dw": 480
        },
        {
          "st": "s",
          "dw": 390
        }
      ]
    }
  },

  "i18n": {
    "en-US": {
      "appName": "Quick Notes"
    }
  },

  "defaultLanguage": "en-US"
}